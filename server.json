{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.asopitech-labs/global-executables",
  "title": "Global Executables",
  "description": "Check whether a CLI command name is already taken across npm, PyPI, crates.io, Go, Debian and more",
  "websiteUrl": "https://asopitech-labs.github.io/global-executables/",
  "repository": {
    "url": "https://github.com/asopitech-labs/global-executables",
    "source": "github"
  },
  "version": "1.4.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "global-executables",
      "version": "1.4.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/asopitech-labs/global-executables-mcp:1.4.1",
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
