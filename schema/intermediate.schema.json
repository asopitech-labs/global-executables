{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "ecosystem", "package", "version", "repository", "source", "confidence"],
  "properties": {
    "command": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"},
    "ecosystem": {"type": "string"}, "package": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "null"]}, "repository": {"type": ["string", "null"]},
    "source": {"type": "string"}, "confidence": {"enum": ["direct", "filesystem", "inferred"]},
    "alias_of": {"type": "string"},
    "source_type": {"type": "string"}, "package_system": {"type": "string"},
    "distribution_family": {"type": "string"}, "distribution": {"type": "string"},
    "distribution_release": {"type": "string"}, "language": {"type": "string"},
    "registry": {"type": "string"}, "latest_release_at": {"type": ["string", "null"]},
    "latest_version": {"type": ["string", "null"]}, "last_observed_at": {"type": ["string", "null"]},
    "release_history": {"type": "array"}, "usage_metrics": {"type": "array"}
  }
}
