{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-executables.dev/schema/executable.schema.json",
  "title": "Canonical executable record",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "providers", "first_seen", "last_seen"],
  "properties": {
    "command": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"},
    "providers": {"type": "array", "minItems": 1, "items": {"$ref": "provider.schema.json"}},
    "first_seen": {"type": "string", "format": "date"},
    "last_seen": {"type": "string", "format": "date"}
  }
}
