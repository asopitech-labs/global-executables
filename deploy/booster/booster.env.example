# Copied to booster.env on the host (never committed). See docs/OPERATIONS.md "Local booster".
CONTACT=you@example.org
# The lease name on artifact-data; one per machine. Never reuse another live booster's id.
BOOSTER_ID=my-host-booster
PUBLISH_INTERVAL=21600
HEARTBEAT_INTERVAL=3600
LEASE_TTL_HOURS=12
# Optional: BOOSTER_RANGES=0-255 or BOOSTER_SLICE=0/2, WORKERS=8, MAX_BYTES_PER_SECOND=5000000
