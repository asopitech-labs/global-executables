# syntax=docker/dockerfile:1
# The PyPI local booster (tools/local_booster.sh, docs/OPERATIONS.md "Local booster") as a
# long-running container for an always-on machine: the supervisor, the Go crawler and the
# git-based publication in one image, state on a volume, restarted by the container runtime.
#
#   docker compose -f deploy/booster/compose.yml up -d --build
#
# The image carries no credentials. The GitHub token that pushes to artifact-data is a file
# on the host, mounted at run time (GITHUB_TOKEN_FILE, default /run/secrets/github_token).

ARG GO_IMAGE=docker.io/library/golang:1.26.11-bookworm@sha256:ea47ee45f1284d60f9cc09cb2c3bb4f508c256b640bd8bb30342ff13d1adcb52

FROM ${GO_IMAGE} AS go-build
ENV GOTOOLCHAIN=local \
    CGO_ENABLED=0
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY tools/go_pipeline.sh ./tools/go_pipeline.sh
RUN ./tools/go_pipeline.sh build

FROM python:3.12-slim-bookworm
# git: lease and publication commits; procps: ps/pgrep for the supervisor's PID checks;
# tini: PID 1 that forwards SIGTERM so `docker stop` gets the final publication and release.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git procps tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 booster \
    && mkdir -p /data && chown booster:booster /data

COPY --from=go-build /workspace/dist/go-registry-crawler /usr/local/bin/go-registry-crawler
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY schema ./schema
RUN pip install --no-cache-dir . && chown booster:booster /app
COPY --chown=booster:booster tools ./tools

USER booster
ENV MODE=native \
    CRAWLER_BIN=/usr/local/bin/go-registry-crawler \
    BASE=/data/ge-crawl \
    GIT_STORE=/data/git \
    GITHUB_TOKEN_FILE=/run/secrets/github_token \
    BOOSTER_SOURCE=pypi \
    PYTHONUNBUFFERED=1
VOLUME ["/data"]
HEALTHCHECK --interval=5m --timeout=30s --start-period=30m --retries=3 \
    CMD ["/app/tools/booster_healthcheck.sh"]
ENTRYPOINT ["/usr/bin/tini", "--", "/app/tools/booster_container.sh"]
